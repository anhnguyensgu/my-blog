{
  "imports": {
    "marked": "npm:marked@^18.0.11",
    "mustache": "npm:mustache@^4.2.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "tasks": {
    "build": "deno run --allow-read=content,templates --allow-write=public src/main.ts build",
    "validate": "deno run --allow-read=content src/main.ts validate",
    "new": "deno run --allow-read=content --allow-write=content src/main.ts new",
    "check": "deno check src/main.ts test/main.test.ts",
    "test": "deno test --allow-read --allow-write",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 110,
    "exclude": ["public", "content", "templates"]
  },
  "lint": {
    "exclude": ["public"]
  }
}
